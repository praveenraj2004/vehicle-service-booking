
pipeline {
    agent any

    stages {

        stage('Welcome') {
            steps {
                echo 'Welcome to Jenkins'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Java application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running test cases'
            }
        }

        stage('Finish') {
            steps {
                echo 'Pipeline completed successfully'
            }
        }
    }
}
